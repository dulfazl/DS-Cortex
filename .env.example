# Copy to .env and fill in. Create the key in Google AI Studio inside a Cloud
# project with billing DISABLED (enabling billing removes the free tier).
GOOGLE_API_KEY=
# gemini-2.5-flash is no longer offered to new keys; an overloaded or retired model hands over to the fallbacks
GEMINI_MODEL=gemini-3.8-flash
# the free tier allows about 20 requests per model per day, so the chain spreads calls across models
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# auto = Gemini when a key is set, otherwise offline templates; gemini | offline force a mode
LLM_MODE=auto
SEED=42
ALLOWED_ORIGINS=http://localhost:3000
# optional pattern, e.g. for a website on Vercel: https://ds-cortex[a-z0-9-]*\.vercel\.app
ALLOWED_ORIGIN_REGEX=
MAX_UPLOAD_MB=50
MAX_CONCURRENT_RUNS=2
DATA_RETENTION_HOURS=72
DAILY_CALL_BUDGET=1000
# ask = pause on leakage blockers; drop/keep = decide automatically (eval harness uses drop)
BLOCKER_POLICY=ask
# small hosts: sample files above this many rows (0 = no cap; the sampling is logged and replayed by the export)
MAX_ROWS=0
# threads for models and BLAS; empty = the container's CPU quota, else all cores
N_JOBS=
# small hosts: fewer Critic reviews and rounds, and models to skip (e.g. gradient_boosting)
CRITIC_TOP_K=
CRITIC_ROUNDS=3
EXCLUDE_MODELS=
# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
